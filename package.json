{
  "name": "takemycard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:vcard": "esbuild scripts/test-vcard.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-vcard.mjs --alias:@=. && node node_modules/.cache/test-vcard.mjs",
    "test:fotos": "esbuild scripts/test-fotos.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-fotos.mjs --alias:@=. && node node_modules/.cache/test-fotos.mjs",
    "test:evento": "esbuild scripts/test-evento.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-evento.mjs --alias:@=. && node node_modules/.cache/test-evento.mjs",
    "test:db": "bash scripts/test-db.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.5",
    "typescript": "^5.9.2"
  }
}
