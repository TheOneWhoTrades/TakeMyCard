# ---------------------------------------------------------------------------
# PLANTILLA. Este archivo se versiona en el repo: NO pongas acá tus valores
# reales. Copialo a .env.local (que está en .gitignore) y editá esa copia:
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# URL del proyecto Supabase. Dashboard -> Project Settings -> API -> Project URL.
#
# Va la URL PELADA, sin rutas. El cliente de Supabase le agrega /rest/v1 solo;
# si la escribís acá, termina pidiendo /rest/v1/rest/v1/... y no encuentra nada.
#   Bien:  https://abcdefghijklmnop.supabase.co
#   Mal:   https://abcdefghijklmnop.supabase.co/rest/v1
#   Mal:   https://abcdefghijklmnop.supabase.co/
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave pública del proyecto. Según la versión del panel se llama:
#   - "Publishable key"  -> sb_publishable_xxxxxxxxxxxx     (nombre nuevo)
#   - "anon" / "public"  -> eyJhbGciOiJIUzI1NiIs...         (nombre viejo)
# Las dos sirven. Es pública por diseño: viaja al navegador de cada visitante y
# lo que protege los datos es Row Level Security, no el secreto de la clave.
#
# NUNCA pongas acá la "service_role" ni una clave sb_secret_...: esas se saltean
# RLS, y todo lo que empieza con NEXT_PUBLIC_ se manda al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Dominio público del sitio, sin barra final. Se usa para armar las URLs
# absolutas del vCard, de los metadatos de Open Graph y de la URL que se graba
# en el chip NFC (https://<sitio>/t/<codigo>).
# En local: http://localhost:3000
# En Vercel podés dejarlo sin definir: se usa VERCEL_URL como fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp al que escriben los interesados desde el sitio comercial.
# Formato internacional, sin +, sin espacios y sin guiones:
#   país (54) + 9 + característica sin el 0 + número sin el 15
# Para un celular de San Luis (característica 266): 5492664123456
#
# Sólo hace falta definirla para usar OTRO número: si se deja vacía, el sitio
# usa el que está por defecto en lib/marca.ts.
NEXT_PUBLIC_WHATSAPP=
